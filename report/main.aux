\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces  \textbf  {Training dynamics of DINOv2 during contrastive fine-tuning on SPair-71k.} From left to right: training loss, validation PCK@0.1, and validation loss. The validation PCK steadily increases while both training and validation losses consistently decrease, indicating stable optimization and absence of overfitting. }}{4}{figure.caption.6}\protected@file@percent }
